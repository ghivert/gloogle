{
  "name": "@gloogle/jupiter",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "jupiter:dev": "nodemon --exec gleam run",
    "jupiter:db:migrate": "dbmate up",
    "jupiter:clean": "gleam clean"
  },
  "nodemonConfig": {
    "ignore": [
      "build/**"
    ],
    "watch": [
      "../../packages",
      "src"
    ],
    "ext": "js,erl,gleam,ex,ts"
  },
  "devDependencies": {
    "@chouquette/gleam": "^1.17.0"
  }
}
